// Retired: gave every account "<username>123". Use scripts/iam/bootstrap.ts.
const bcrypt = require('bcryptjs');
const pg = require('pg');
const pool = new pg.Pool({ connectionString: 'postgresql:///lms_dev?host=/tmp' });

async function setPasswords() {
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    await client.query("SELECT api.set_actor('00000000-0000-0000-0000-000000000001');");
    const users = await client.query('SELECT username FROM lms.app_user WHERE is_service_account = false;');
    for (const row of users.rows) {
      const pw = row.username === 'admin' ? 'admin123' : `${row.username}123`;
      const hash = await bcrypt.hash(pw, 10);
      await client.query('UPDATE lms.app_user SET password_hash = $1 WHERE username = $2;', [hash, row.username]);
      console.log(`Configured password for ${row.username} -> ${pw}`);
    }
    await client.query('COMMIT');
    console.log('All passwords successfully configured.');
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('Password seed failed:', err);
  } finally {
    client.release();
    await pool.end();
  }
}

setPasswords();
