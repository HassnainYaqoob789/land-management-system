# Copy to .env.production.local on the server and fill in. Never commit the filled file.
# See docs/deploy/DREAMHOST_VPS_DEPLOYMENT.md §6.
NODE_ENV=production
DATABASE_URL=postgresql://lms_app:CHANGE_ME@127.0.0.1:5432/lms_prod
APP_ORIGIN=https://lms.example.com
APP_ALLOWED_ORIGINS=
IAM_COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
# openssl rand -base64 32
IAM_HMAC_KEY=
# k1:<openssl rand -base64 32>
IAM_MASTER_KEYS=
DOCUMENT_STORE_DIR=/var/lib/lms/documents
DB_POOL_MAX=10
IAM_TOTP_ISSUER=Mari Energies LMS
IAM_RP_NAME=Mari Energies LMS
# Demo only, never in production:
# LMS_DEMO_MODE=on
# LMS_DEMO_CREDENTIALS_FILE=
