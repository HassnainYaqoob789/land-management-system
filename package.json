{
  "name": "mari-energies-lms",
  "version": "2.0.0",
  "description": "Mari Energies Limited Land Management System (LMS) - Production Next.js + Node.js + PostgreSQL",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all",
    "test:unit": "node --experimental-strip-types --test tests/unit/domain.test.js tests/unit/geo.test.js tests/unit/measurement_units.test.js",
    "test:integration": "node --experimental-strip-types --test tests/integration/gis_kml.test.js",
    "test:playwright": "playwright test",
    "test:a11y": "playwright test tests/e2e/legacy_design.spec.ts -g \"WCAG\"",
    "test:db": "python3 db/tools/run_tests.py",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:db && npm run test:api && npm run test:playwright",
    "db:ingest:reference": "tsx scripts/ingest_reference_data.ts",
    "worker:sap": "tsx scripts/sap_outbox_worker.ts",
    "demo:setup": "node scripts/demo/setup_demo.mjs",
    "test:api": "vitest run tests/iam tests/regression",
    "test:sap": "node --experimental-strip-types --test tests/integration/sap_worker.test.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "4.4.0",
    "clsx": "^2.1.1",
    "ldapts": "^9.2.0",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "4.7.1",
    "next": "^15.1.0",
    "nodemailer": "10.1.7",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "pdfkit": "0.20.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "ldapjs": "3.0.7",
    "oidc-provider": "9.12.2",
    "postcss": "^8.4.49",
    "smtp-server": "3.19.22",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
